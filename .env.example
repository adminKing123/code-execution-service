# Required — API clients must send this key (Bearer or X-API-Key)
SERVICE_API_KEY=

# Required — Flask session/signing secret (generate a long random string)
FLASK_SECRET_KEY=

# Required — admin panel login password
ADMIN_PASSWORD=

# Optional — execution limits (seed SQLite settings on first run)
EXECUTION_TIMEOUT_SECONDS=30
MAX_CODE_BYTES=262144
DATABASE_PATH=sqlite3.db

# Optional — local dev server bind
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
